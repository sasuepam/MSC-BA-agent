# MSC BA MCP Server Configuration
# Copy this file to .env and fill in your values.
# All variables are prefixed with MSC_

# --- Server ---
MSC_HOST=0.0.0.0
MSC_PORT=8080
MSC_TRANSPORT=sse
MSC_DEBUG=false
MSC_SERVER_NAME=msc-ba-mcp-server

# API token that Codemie must send (leave empty to disable auth)
MSC_API_TOKEN=

# --- Jira ---
MSC_JIRA_URL=https://msccruises.atlassian.net
MSC_JIRA_TOKEN=
MSC_JIRA_EMAIL=

# --- Confluence ---
# URL: your Atlassian domain (no /wiki suffix needed)
# Email: your Atlassian account email
# Token: generate at https://id.atlassian.com/manage/api-tokens
MSC_CONFLUENCE_URL=https://msccruises.atlassian.net
MSC_CONFLUENCE_EMAIL=you@msccruises.com
MSC_CONFLUENCE_TOKEN=

# --- Confluence Sandbox (optional — for draft page creation) ---
MSC_CONFLUENCE_SANDBOX_URL=
MSC_CONFLUENCE_SANDBOX_EMAIL=
MSC_CONFLUENCE_SANDBOX_TOKEN=

# --- MuleSoft Anypoint (Phase 3 — leave empty for now) ---
MSC_ANYPOINT_URL=https://anypoint.mulesoft.com
MSC_ANYPOINT_CLIENT_ID=
MSC_ANYPOINT_CLIENT_SECRET=

# --- Git (Phase 5 — leave empty for now) ---
MSC_GIT_PROVIDER=github
MSC_GIT_TOKEN=
MSC_GIT_BASE_URL=

# --- Microsoft 365 (Phase 4 — leave empty for now) ---
MSC_MS_TENANT_ID=
MSC_MS_CLIENT_ID=
MSC_MS_CLIENT_SECRET=
